{
  "name": "users",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/users/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/users",
        "browser": "apps/users/src/main.ts",
        "tsConfig": "apps/users/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/users/public",
          {
            "glob": "**/*",
            "input": "libs/core/src/assets",
            "output": "/assets"
          }
        ],
        "styles": [
          "apps/users/src/styles.scss",
          {
            "input": "libs/core/src/assets/themes/light-mode.scss",
            "bundleName": "light-mode",
            "inject": false
          },
          {
            "input": "libs/core/src/assets/themes/dark-mode.scss",
            "bundleName": "dark-mode",
            "inject": false
          }
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "users:build:production"
        },
        "development": {
          "buildTarget": "users:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "users:build",
        "staticFilePath": "dist/apps/users/browser",
        "spa": true
      }
    }
  }
}
